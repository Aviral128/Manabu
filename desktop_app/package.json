{
  "name": "manabu-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "MANABU Desktop launcher for the learner app, admin panel, and developer portal.",
  "author": "Aviral Sultaniya",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npx @electron/packager . \"MANABU Desktop\" --platform=win32 --arch=x64 --out=dist --overwrite --asar --prune=false"
  },
  "devDependencies": {
    "@electron/packager": "^19.0.5",
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.manabu.desktop",
    "productName": "MANABU Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
