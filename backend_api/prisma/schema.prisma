generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  LEARNER
  MANAGER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  MIXED
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  name                    String
  passwordHash            String?                  @map("password_hash")
  role                    Role                     @default(LEARNER)
  status                  UserStatus               @default(ACTIVE)
  isEmailVerified         Boolean                  @default(false) @map("is_email_verified")
  avatarUrl               String?                  @map("avatar_url")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  attempts                QuizAttempt[]
  leaderboard             Leaderboard?
  adminLogs               AdminLog[]               @relation("AdminActor")
  emailVerificationTokens EmailVerificationToken[]

  @@map("users")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model MagicLinkToken {
  id        String       @id @default(cuid())
  email     String
  token     String       @unique
  expiresAt DateTime     @map("expires_at")
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([email])
  @@index([expiresAt])
  @@map("magic_link_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Quiz {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  description      String?
  category         String?
  difficulty       Difficulty    @default(MEDIUM)
  estimatedMinutes Int           @default(15) @map("estimated_minutes")
  isSpecial        Boolean       @default(false) @map("is_special")
  tags             Json          @default("[]")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  questions        Question[]
  attempts         QuizAttempt[]

  @@map("quizzes")
}

model Question {
  id          String     @id @default(cuid())
  quizId      String     @map("quiz_id")
  prompt      String
  options     Json
  answerIndex Int        @map("answer_index")
  explanation String?
  order       Int
  difficulty  Difficulty @default(MEDIUM)
  quiz        Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("questions")
}

model QuizAttempt {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  quizId         String   @map("quiz_id")
  score          Int
  xpEarned       Int      @map("xp_earned")
  correctAnswers Int      @map("correct_answers")
  totalQuestions Int      @map("total_questions")
  completedAt    DateTime @default(now()) @map("completed_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

model Leaderboard {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  points    Int      @default(0)
  level     Int      @default(1)
  badges    Json     @default("[]")
  streak    Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("leaderboard")
}

model AdminLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation("AdminActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@map("admin_logs")
}
